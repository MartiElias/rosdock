#!/usr/bin/env bash
set -euo pipefail
ARGC_ORIG=$#   # to know if the command was called with arguments
PWD_ABS="$(pwd)"

# Define global variables
SNAME="easydock"
CONFIG_FD_PATH=".$SNAME"
CONFIG_FILE_NAME="config.yml"
BASH_FILE="bash_setup.txt"
ENTRYPOINT_FILE="entrypoint.sh"


docker_container_connect() {
  CONTAINER=$NAME

  if [ "$(docker ps -aq -f name=^${CONTAINER}$)" ]; then
      if [ "$(docker ps -q -f name=^${CONTAINER}$)" ]; then
          echo "The Container '$CONTAINER' is running. Connecting ..."
          docker exec -it "$CONTAINER" /bin/bash
      else
          echo "The container '$CONTAINER' exist but it's stoped. Connecting ..."
          docker start "$CONTAINER"
          docker exec -it "$CONTAINER" /bin/bash
      fi
  fi
}

ensure_local_config() {
  local cfg_dir="$PWD/$CONFIG_FD_PATH"
  local cfg_yml="$cfg_dir/$CONFIG_FILE_NAME"
  local ep_sh="$cfg_dir/$ENTRYPOINT_FILE"
  local bash_setup="$cfg_dir/$BASH_FILE"

  # create folder if it doesn't exist
  mkdir -p "$cfg_dir"

  # Values to write in $CONFIG_FILE_NAME
  local image_val root_val name_val
  if (( ARGC_ORIG > 0 )); then
    # use config CLI/YAML
    image_val="${IMAGE:-ros:humble}"
    root_val="${ROOT:-/work}"
    name_val="${NAME:-ros}"
  else
    # default values if no arguments were given
    image_val="ubuntu"
    root_val="/work_dir"
    name_val="container_name"
  fi

  # create $CONFIG_FILE_NAME if it doesn't exist
  if [[ ! -f "$cfg_yml" ]]; then
    cat > "$cfg_yml" <<EOF
# Local config (auto-generated)
image_name: ${image_val}
init_root: ${root_val}
container_name: ${name_val}
gpus: ${GPUS:-0}
env:
  LANG: C.UTF-8
  RMW_IMPLEMENTATION: rmw_fastrtps_cpp
device:
  - /dev/snd
group_add:
  - audio
EOF
    echo "[$SNAME] created $cfg_yml"
  fi

  # create $ENTRYPOINT_FILE if it doesn't exist
  if [[ ! -f "$ep_sh" ]]; then
    cat > "$ep_sh" <<EOSH
#!/usr/bin/env bash
set -euo pipefail

# Save bash_history to the $SNAME Folder
cat >> ~/.bashrc <<'EOF'
# Historial más fiable en contenedores/terminales
shopt -s histappend
export HISTFILE="\$HOME/.bash_history"
export HISTSIZE=10000
export HISTFILESIZE=20000

# In each prompt, add the new HISTFILE and reload the other shells
PROMPT_COMMAND='history -a; history -n'

# On Exit: output the history 
trap 'history -a; history -w; cp "\$HISTFILE" /$SNAME/bash_history 2>/dev/null || true' EXIT
EOF

# Copy bash_setup lines
cat "/$SNAME/${BASH_FILE}" >> ~/.bashrc

# Run the given command
exec "\$@"
EOSH
    echo "[$SNAME] create $ep_sh"
    chmod +x $ep_sh
  fi

  if [[ ! -f "$bash_setup" ]]; then
    cat > "$bash_setup" <<'EOSH'
# soruce /work/ros2_ws/install/setup.bash
EOSH
    echo "[$SNAME] create $bash_setup"
  fi
}

# -----------------------------
# Default (arg, can come from $CONFIG_FILE_NAME or CLI)
# -----------------------------
IMAGE="ubuntu"
ROOT="/work"
NAME="container_name"
GPUS="0"             
SUBCMD="run"         # run|attach
EXTRA_ENVS=()
EXTRA_DEVICES=()
EXTRA_GROUPS=()
DOCKER_ARGS_STR=""
VERBOSE=0

# -----------------------------
# Helpers
# -----------------------------
die(){ echo "$SNAME: $*" >&2; exit 1; }

have(){ command -v "$1" >/dev/null 2>&1; }

docker_ok(){
  have docker || die "docker is not on the PATH"
  docker info >/dev/null 2>&1 || die "Docker daemon not responding"
}

usage(){
  cat <<EOF
Usage: $SNAME [options] [--] [CMD...]        (default mode = run)
       $SNAME attach                         (tries to attach to an existing container)

Options:
  --image=IMAGE           (default: $IMAGE)
  --root=PATH             root directory inside the container (default: $ROOT)
  --name=NAME             container name (default: $SNAME-<folder>-<hash>)
  --gpus                  adds --gpus all
  --env KEY=VAL           adds an environment variable (repeatable)
  --mount spec            adds --mount (repeatable, Docker --mount format)
  --device                devices to connect
  --group_add             additional group to add, such as video or audio
  --docker_args           docker arguments
  --verbose               prints the full docker command being executed
  attach                  subcommand: attach to an existing project container
  -h, --help              show this help message

Examples:
  $SNAME --image=ros:humble --root=/work --name=ros_humble

EOF
}

# -----------------------------
# Load config YAML (if you have yq)
# -----------------------------
CONFIG_FILE="${XDG_CONFIG_HOME:-$PWD_ABS}/$CONFIG_FD_PATH/$CONFIG_FILE_NAME"

if [[ -f "$CONFIG_FILE" ]] && have yq; then
  echo "[$SNAME] Loading config file: ${CONFIG_FILE}"

  IMAGE="$(yq -r '.image_name // "'"$IMAGE"'"' "$CONFIG_FILE")"
  ROOT="$(yq -r '.init_root // "'"$ROOT"'"' "$CONFIG_FILE")"
  NAME="$(yq -r '.container_name // "'"$NAME"'"' "$CONFIG_FILE")"
  GPUS_VAL="$(yq -r '.gpus // ""' "$CONFIG_FILE")"

  if [[ "$GPUS_VAL" == "true" || "$GPUS_VAL" == "1" ]]; then
    GPUS="1"
  else
    GPUS="0"
  fi

  # env: map KEY: VAL
  if yq -e '.env' "$CONFIG_FILE" >/dev/null 2>&1; then
    while IFS="=" read -r key val; do
      [[ -n "$key" && -n "$val" ]] && EXTRA_ENVS+=( -e "$key=$val" )
    done < <(yq -r '.env | to_entries[] | "\(.key)=\(.value)"' "$CONFIG_FILE")
  fi

    # device: list
  if yq -e '.device' "$CONFIG_FILE" >/dev/null 2>&1; then
    while IFS= read -r dev; do
      [[ -n "$dev" ]] && EXTRA_DEVICES+=( --device "$dev" )
    done < <(yq -r '.device[]' "$CONFIG_FILE")
  fi

  # group_add: list
  if yq -e '.group_add' "$CONFIG_FILE" >/dev/null 2>&1; then
    while IFS= read -r grp; do
      [[ -n "$grp" ]] && EXTRA_GROUP_ADDS+=( --group-add "$grp" )
    done < <(yq -r '.group_add[]' "$CONFIG_FILE")
  fi

fi


# -----------------------------
# Parse CLI
# -----------------------------
if [[ $# -gt 0 && "$1" == "attach" ]]; then SUBCMD="attach"; shift; fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image=*) IMAGE="${1#*=}" ;;
    --root=*) ROOT="${1#*=}" ;;
    --name=*) NAME="${1#*=}" ;;
    --gpus|--gpus=*)
      val="${1#*=}"
      if [[ "$val" == "$1" || -z "$val" || "$val" == "1" || "$val" == "true" ]]; then
        GPUS="1"
      else
        GPUS="0"
      fi
      ;;
    --env) shift; [[ $# -gt 0 ]] || die "--env requires KEY=VAL"; EXTRA_ENVS+=( -e "$1" ) ;;
    --env=*) EXTRA_ENVS+=( -e "${1#*=}" ) ;;
    --mount) shift; [[ $# -gt 0 ]] || die "--mount requires spec"; EXTRA_MOUNTS+=( --mount "$1" ) ;;
    --device) shift; [[ $# -gt 0 ]] || die "--device requires /dev/xxx"; EXTRA_DEVICES+=( --device "$1" ) ;;
    --device=*) EXTRA_DEVICES+=( --device "${1#*=}" ) ;;
    --group_add) shift; [[ $# -gt 0 ]] || die "--group_add requires group or GID"; EXTRA_GROUP_ADDS+=( --group_add "$1" ) ;;
    --group_add=*) EXTRA_GROUP_ADDS+=( --group_add "${1#*=}" ) ;;
    --docker_args=*) DOCKER_ARGS_STR="${1#*=}" ;;
    --verbose*) VERBOSE=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

ensure_local_config


CMD=( "$@" )
[[ ${#CMD[@]} -eq 0 ]] && CMD=( /bin/bash )

docker_ok

BASE="$(basename "$PWD_ABS")"
[[ -z "$NAME" ]] && NAME="$SNAME-${BASE}-${HASH}"

echo "[$SNAME] image=$IMAGE  root=$ROOT  name=$NAME"

# -----------------------------
# Prepare docker run args
# -----------------------------
DOCKER_ARGS=(
  run -it --rm
  --network host
  -e DISPLAY=${DISPLAY}
  -e TERM="$TERM" 
  -e COLORTERM="${COLORTERM:-truecolor}"
  -v /tmp/.X11-unix:/tmp/.X11-unix:rw
  --name "$NAME"
  --mount "type=bind,src=$PWD_ABS,dst=$ROOT"
  -v $PWD_ABS/$CONFIG_FD_PATH:/$SNAME
  --entrypoint /$SNAME/$ENTRYPOINT_FILE
)

# Add ENV args
DOCKER_ARGS+=( "${EXTRA_ENVS[@]}" )
# Add DEVICE args
DOCKER_ARGS+=( "${EXTRA_DEVICES[@]}" )
# Add GROUP_ADD args
DOCKER_ARGS+=( "${EXTRA_GROUP_ADDS[@]}" )

# Add extra docker args
EXTRA_DOCKER_ARGS=()
if [[ -n "$DOCKER_ARGS_STR" ]]; then
  read -r -a EXTRA_DOCKER_ARGS <<< "$DOCKER_ARGS_STR"
fi
DOCKER_ARGS+=( "${EXTRA_DOCKER_ARGS[@]}" )


# GPUs (latest toolkits only: NVIDIA nvidia-container-toolkit, AMD ROCm runtime)
if [[ "$GPUS" == "1" ]]; then
  RUNTIMES_JSON="$(docker info --format '{{json .Runtimes}}' 2>/dev/null || echo '{}')"

  if command -v nvidia-smi >/dev/null 2>&1; then
    # NVIDIA (nvidia-container-toolkit)
    DOCKER_ARGS+=( --gpus all -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all )
    echo "[$SNAME] NVIDIA GPU loaded"

  elif [[ -e /dev/kfd || -d /dev/dri ]]; then
    # AMD (ROCm runtime moderno)
    if grep -q '"amd"' <<<"$RUNTIMES_JSON"; then
      DOCKER_ARGS+=(
        --runtime=amd
        --device=/dev/kfd
        --device=/dev/dri
        --group-add video
        --group-add render
        --security-opt seccomp=unconfined
        -e AMD_VISIBLE_DEVICES="${AMD_VISIBLE_DEVICES:-all}"
      )
      echo "[$SNAME] AMD GPU loaded"
    else
      echo "[$SNAME] AMD GPU detected but 'amd' runtime not available; skipping GPU flags" >&2
    fi

  else
    echo "[$SNAME] GPU requested but no GPU detected" >&2
  fi
fi



# Image and container
DOCKER_ARGS+=( "$IMAGE" )
DOCKER_ARGS+=( "${CMD[@]}" )

# verbose flag
echo ""
if [[ "$VERBOSE" == "1" ]] then
  echo "${DOCKER_ARGS[@]}"
fi

# Check if the container exist
docker_container_connect

# Exec
exec docker "${DOCKER_ARGS[@]}"
