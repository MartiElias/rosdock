#!/usr/bin/env bash
set -euo pipefail
PWD_ABS="$(pwd)"

# Define global variables
SNAME="rosdock"
AUTO_REMOVE="1"
CONFIG_FD_PATH=".$SNAME"
CONFIG_FILE_NAME="config.yml"
BASH_FILE="bash_setup.txt"
ENTRYPOINT_FILE="entrypoint.sh"


docker_container_connect() {
  local running
  running="$(docker inspect --type container --format '{{.State.Running}}' "$NAME" 2>/dev/null)" || return 1

  if [[ "$running" != "true" ]]; then
    echo "The container '$NAME' is stopped. Starting ..."
    docker start "$NAME" || die "Could not start container '$NAME'"
  fi
  echo "Connecting to container '$NAME' ..."
  exec docker exec -it "$NAME" /bin/bash
}

ensure_local_config() {
  local cfg_dir="$PWD/$CONFIG_FD_PATH"
  local cfg_yml="$cfg_dir/$CONFIG_FILE_NAME"
  local ep_sh="$cfg_dir/$ENTRYPOINT_FILE"
  local bash_setup="$cfg_dir/$BASH_FILE"

  # create folder if it doesn't exist
  mkdir -p "$cfg_dir"

  local audio_devices="[]" audio_groups="[]"
  if [[ -e /dev/snd ]]; then
    audio_devices="[/dev/snd]"
    audio_groups="[audio]"
  fi

  # create $CONFIG_FILE_NAME if it doesn't exist
  if [[ ! -f "$cfg_yml" ]]; then
    cat > "$cfg_yml" <<EOF
# Local config (auto-generated)
image_name: ${IMAGE}
work_folder: ${ROOT}
container_name: ${NAME}
gpus: ${GPUS:-0}
display: ${DISPLAY_EN}
env:
  LANG: C.UTF-8
  RMW_IMPLEMENTATION: rmw_fastrtps_cpp
  # On systems with integrated graphics and a dedicated NVIDIA GPU,
  # we recommend uncommenting these variables so applications render with NVIDIA.
  # Otherwise, NVIDIA may be detected but applications may still use integrated graphics.
  # Also enable GPU access with gpus: 1 (outside env) or --gpus=1.
  # __NV_PRIME_RENDER_OFFLOAD: "1"
  # __GLX_VENDOR_LIBRARY_NAME: nvidia
device: ${audio_devices}
group_add: ${audio_groups}
EOF
    echo "[$SNAME] created $cfg_yml"
  fi

  # create $ENTRYPOINT_FILE if it doesn't exist
  if [[ ! -f "$ep_sh" ]]; then
    cat > "$ep_sh" <<EOSH
#!/usr/bin/env bash
set -euo pipefail

# Save bash_history to the $SNAME Folder
cat >> ~/.bashrc <<'EOF'
# More reliable track record in containers/terminals
shopt -s histappend
export HISTFILE="/$SNAME/bash_history"
export HISTSIZE=10000
export HISTFILESIZE=20000

# In each prompt, add the new HISTFILE and reload the other shells
PROMPT_COMMAND='history -a; history -n'

trap 'history -a' EXIT
EOF

# Copy bash_setup lines
cat "/$SNAME/${BASH_FILE}" >> ~/.bashrc

# Run the given command
exec "\$@"
EOSH
    echo "[$SNAME] create $ep_sh"
    chmod +x "$ep_sh"
  fi

  if [[ ! -f "$bash_setup" ]]; then
    cat > "$bash_setup" <<'EOSH'
# source /work/ros2_ws/install/setup.bash
EOSH
    echo "[$SNAME] create $bash_setup"
  fi
}

# -----------------------------
# Default (arg, can come from $CONFIG_FILE_NAME or CLI)
# -----------------------------
IMAGE="ubuntu"
ROOT="/work"
NAME="container_name"
GPUS="0"     
DISPLAY_EN="1"        
SUBCMD="run"         # run|attach
EXTRA_ENVS=()
EXTRA_DEVICES=()
EXTRA_GROUP_ADDS=()
EXTRA_MOUNTS=()
DOCKER_ARGS_STR=""
VERBOSE=0

# -----------------------------
# Helpers
# -----------------------------
die(){ echo "$SNAME: $*" >&2; exit 1; }

have(){ command -v "$1" >/dev/null 2>&1; }

docker_ok(){
  have docker || die "docker is not on the PATH"
  docker info >/dev/null 2>&1 || die "Docker daemon not responding"
}

usage(){
  cat <<EOF
Usage: $SNAME [options] [--] [CMD...]        (default mode = run)
       $SNAME attach                         (tries to attach to an existing container)

Options:
  --image=IMAGE           (default: $IMAGE)
  --rm=0|1                remove container on exit (default: 1)
  --root=PATH             root directory inside the container (default: $ROOT)
  --name=NAME             container name (default: $NAME)
  --gpus                  adds --gpus all
  --display               enable or disable display for GUI applications
  --env KEY=VAL           adds an environment variable (repeatable)
  --mount spec            adds --mount (repeatable, Docker --mount format)
  --device                devices to connect
  --group_add             additional group to add, such as video or audio
  --docker_args           docker arguments
  --verbose               prints the full docker command being executed
  attach                  subcommand: attach to an existing project container
  -h, --help              show this help message

Examples:
  $SNAME --image=ros:humble --root=/work --name=ros_humble

EOF
}

# -----------------------------
# Load config YAML (if you have yq)
# -----------------------------
CONFIG_FILE="$PWD_ABS/$CONFIG_FD_PATH/$CONFIG_FILE_NAME"

if [[ -f "$CONFIG_FILE" ]]; then
  have yq || die "yq is required to read $CONFIG_FILE; run install.sh first"
  echo "[$SNAME] Loading config file: ${CONFIG_FILE}"

  IMAGE="$(yq -r '.image_name // "'"$IMAGE"'"' "$CONFIG_FILE")"
  ROOT="$(yq -r '.work_folder // "'"$ROOT"'"' "$CONFIG_FILE")"
  NAME="$(yq -r '.container_name // "'"$NAME"'"' "$CONFIG_FILE")"
  GPUS_VAL="$(yq -r '.gpus // ""' "$CONFIG_FILE")"

  if [[ "$GPUS_VAL" == "true" || "$GPUS_VAL" == "1" ]]; then
    GPUS="1"
  else
    GPUS="0"
  fi

  DISPLAY_VAL="$(yq -r '.display // ""' "$CONFIG_FILE")"
  if [[ "$DISPLAY_VAL" == "true" || "$DISPLAY_VAL" == "1" || "$DISPLAY_VAL" == "enable" ]]; then
    DISPLAY_EN="1"
  else
    DISPLAY_EN="0"
  fi

  # env: map KEY: VAL
  if yq -e '.env' "$CONFIG_FILE" >/dev/null 2>&1; then
    env_values="$(yq -r '.env | to_entries[] | "\(.key)=\(.value)"' "$CONFIG_FILE")"
    while IFS="=" read -r key val; do
      if [[ -n "$key" ]]; then EXTRA_ENVS+=( -e "$key=$val" ); fi
    done <<< "$env_values"
  fi

    # device: list
  if yq -e '.device' "$CONFIG_FILE" >/dev/null 2>&1; then
    device_values="$(yq -r '.device[]' "$CONFIG_FILE")"
    while IFS= read -r dev; do
      if [[ -n "$dev" ]]; then EXTRA_DEVICES+=( --device "$dev" ); fi
    done <<< "$device_values"
  fi

  # group_add: list
  if yq -e '.group_add' "$CONFIG_FILE" >/dev/null 2>&1; then
    group_values="$(yq -r '.group_add[]' "$CONFIG_FILE")"
    while IFS= read -r grp; do
      if [[ -n "$grp" ]]; then EXTRA_GROUP_ADDS+=( --group-add "$grp" ); fi
    done <<< "$group_values"
  fi

fi


# -----------------------------
# Parse CLI
# -----------------------------
if [[ $# -gt 0 && "$1" == "attach" ]]; then SUBCMD="attach"; shift; fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image=*) IMAGE="${1#*=}" ;;
    --rm|--rm=1|--rm=true) AUTO_REMOVE="1" ;;
    --rm=0|--rm=false) AUTO_REMOVE="0" ;;
    --rm=*) die "--rm requires 0, 1, false or true" ;;
    --root=*) ROOT="${1#*=}" ;;
    --name=*) NAME="${1#*=}" ;;
    --gpus|--gpus=*)
      val="${1#*=}"
      if [[ "$val" == "$1" || -z "$val" || "$val" == "1" || "$val" == "true" ]]; then
        GPUS="1"
      else
        GPUS="0"
      fi
      ;;
    --display|--display=*)
      val="${1#*=}"
      if [[ "$val" == "$1" || -z "$val" || "$val" == "1" || "$val" == "true" || "$val" == "enable" ]]; then
        DISPLAY_EN="1"
      else
        DISPLAY_EN="0"
      fi
      ;;
    --env) shift; [[ $# -gt 0 ]] || die "--env requires KEY=VAL"; EXTRA_ENVS+=( -e "$1" ) ;;
    --env=*) EXTRA_ENVS+=( -e "${1#*=}" ) ;;
    --mount) shift; [[ $# -gt 0 ]] || die "--mount requires spec"; EXTRA_MOUNTS+=( --mount "$1" ) ;;
    --device) shift; [[ $# -gt 0 ]] || die "--device requires /dev/xxx"; EXTRA_DEVICES+=( --device "$1" ) ;;
    --device=*) EXTRA_DEVICES+=( --device "${1#*=}" ) ;;
    --group_add) shift; [[ $# -gt 0 ]] || die "--group_add requires group or GID"; EXTRA_GROUP_ADDS+=( --group-add "$1" ) ;;
    --group_add=*) EXTRA_GROUP_ADDS+=( --group-add "${1#*=}" ) ;;
    --docker_args=*) DOCKER_ARGS_STR="${1#*=}" ;;
    --verbose*) VERBOSE=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

CMD=( "$@" )
[[ ${#CMD[@]} -eq 0 ]] && CMD=( /bin/bash )

docker_ok

[[ -n "$NAME" ]] || die "container name must not be empty"

if ! docker_container_connect; then
  [[ "$SUBCMD" != "attach" ]] || die "Container '$NAME' does not exist"
fi

ensure_local_config

echo "[$SNAME] image=$IMAGE  root=$ROOT  name=$NAME"

# -----------------------------
# Prepare docker run args
# -----------------------------
DOCKER_ARGS=(
  run -it
  --network host
  -e TERM="${TERM:-xterm}"
  -e COLORTERM="${COLORTERM:-truecolor}"
  --name "$NAME"
  --mount "type=bind,src=$PWD_ABS,dst=$ROOT"
  -v "$PWD_ABS/$CONFIG_FD_PATH:/$SNAME"
  --entrypoint /$SNAME/$ENTRYPOINT_FILE
)

# Add --rm config
if [[ "$AUTO_REMOVE" == "1" ]]; then
  DOCKER_ARGS+=( --rm )
fi

# Add Display config
if [[ "$DISPLAY_EN" == "1" && -n "${DISPLAY:-}" ]]; then
  DOCKER_ARGS+=( -e "DISPLAY=${DISPLAY}" -v /tmp/.X11-unix:/tmp/.X11-unix:rw )
fi

# Add ENV args
DOCKER_ARGS+=( "${EXTRA_ENVS[@]}" )
# Add DEVICE args
DOCKER_ARGS+=( "${EXTRA_DEVICES[@]}" )
# Add GROUP_ADD args
DOCKER_ARGS+=( "${EXTRA_GROUP_ADDS[@]}" )
# Add MOUNT args
DOCKER_ARGS+=( "${EXTRA_MOUNTS[@]}" )

# Add extra docker args
EXTRA_DOCKER_ARGS=()
if [[ -n "$DOCKER_ARGS_STR" ]]; then
  read -r -a EXTRA_DOCKER_ARGS <<< "$DOCKER_ARGS_STR"
fi
DOCKER_ARGS+=( "${EXTRA_DOCKER_ARGS[@]}" )


# GPUs (latest toolkits only: NVIDIA nvidia-container-toolkit, AMD ROCm runtime)
if [[ "$GPUS" == "1" ]]; then
  RUNTIMES_JSON="$(docker info --format '{{json .Runtimes}}' 2>/dev/null || echo '{}')"

  if command -v nvidia-smi >/dev/null 2>&1; then
    # NVIDIA (nvidia-container-toolkit)
    DOCKER_ARGS+=( --gpus all -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all )
    echo "[$SNAME] NVIDIA GPU loaded"

  elif [[ -e /dev/kfd || -d /dev/dri ]]; then
    # AMD (ROCm runtime moderno)
    if grep -q '"amd"' <<<"$RUNTIMES_JSON"; then
      DOCKER_ARGS+=(
        --device=/dev/kfd
        --device=/dev/dri
        --security-opt seccomp=unconfined
      )
      echo "[$SNAME] AMD GPU loaded"
    else
      echo "[$SNAME] AMD GPU detected, error loading." >&2
    fi

  else
    echo "[$SNAME] GPU requested but no GPU detected" >&2
  fi
fi



# Image and container
DOCKER_ARGS+=( "$IMAGE" )
DOCKER_ARGS+=( "${CMD[@]}" )

# verbose flag
if [[ "$VERBOSE" == "1" ]]; then
  printf '\ndocker %q' "${DOCKER_ARGS[0]}"

  for ((i=1; i<${#DOCKER_ARGS[@]}; i++)); do
    printf ' \\\n  %q' "${DOCKER_ARGS[i]}"

    case "${DOCKER_ARGS[i]}" in
      -e|-v|--network|--name|--mount|--entrypoint|--device|--group-add|--gpus|--security-opt)
        if (( i + 1 < ${#DOCKER_ARGS[@]} )); then
          i=$((i + 1))
          printf ' %q' "${DOCKER_ARGS[i]}"
        fi
        ;;
    esac
  done

  printf '\n'
fi

# Exec
exec docker "${DOCKER_ARGS[@]}"
